{
  "name": "hostel-management-neo4j-root",
  "version": "1.0.0",
  "description": "Hostel Management System with Neo4j AuraDB backend and React frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "cd backend && npm install",
    "build": "cd backend && npm install",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "test-sql": "cd backend && npm run test-sql",
    "test-api": "cd backend && npm run test-api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "neo4j-driver": "^6.2.0",
    "node-sql-parser": "^5.4.0"
  }
}
